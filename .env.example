# Copy to .env and fill in. .env is gitignored; never commit real values.

# Local Postgres in Docker (docker-compose.yml), also used by dbt and the tests.
POSTGRES_USER=icu_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=icu_warehouse

# The HMAC key for dim_patient.subject_key: 64 hex characters. Generate with
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep it outside the database. Losing it means new codes; leaking it means
# rotating it (see security/pseudonymize.sql).
ICU_HMAC_KEY=

# Optional: the owner connection string of a hosted Neon branch, for loading
# and building there instead of locally.
# NEON_MAIN_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require