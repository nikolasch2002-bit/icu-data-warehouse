[sqlfluff]
dialect = postgres
# ST06 (structure.column_order) wants calculated columns after plain ones.
# Dimensions list their surrogate key, a row_number(), first, which is the
# convention readers expect, so the rule is off.
exclude_rules = structure.column_order

# Column names that are also SQL keywords, kept because they are the clearest
# names: language and label are what MIMIC calls them; year and month are
# dim_date columns.
[sqlfluff:rules:references.keywords]
ignore_words = language,label,year,month

# sqlfluff renders dbt models without dbt, so give it a stand-in for env_var().
[sqlfluff:templater:jinja:macros]
env_var = {% macro env_var(name, default="") %}placeholder{% endmacro %}
